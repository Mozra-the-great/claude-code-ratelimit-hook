{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/rate-limit-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/rate-limit-waiter.sh",
            "timeout": 610000,
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Rate limit window reset"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/rate-limit-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/rate-limit-waiter.sh",
            "timeout": 610000,
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Rate limit window reset"
          }
        ]
      }
    ]
  }
}
